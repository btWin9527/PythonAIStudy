# ============================================================================
# HelloAgents 统一环境变量配置文件
# ============================================================================
# 复制此文件为 .env 并填入你的API密钥
# 系统要求：Python 3.10+ （必需）

# ============================================================================
# 🚀 统一配置格式（推荐）- 框架自动检测provider
# ============================================================================
# 只需配置以下4个通用环境变量，框架会自动识别LLM提供商：

# 模型名称
LLM_MODEL_ID=qwen-max

# API密钥
LLM_API_KEY=sk-f92f3376b228495ead811aa7f2e33021

# 服务地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# ============================================================================
# 🛠️ 工具配置（可选）
# ============================================================================

# Tavily搜索（推荐）- 获取API密钥：https://tavily.com/
 TAVILY_API_KEY=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

# SerpApi搜索（备选）- 获取API密钥：https://serpapi.com/
# SERPAPI_API_KEY=your_serpapi_key_here

#MODELSCOPE_API_KEY=ms-6f6558c7-e849-439b-95e0-b2afcdf2122c


# ================================
# Qdrant 向量数据库配置 - 获取API密钥：https://cloud.qdrant.io/
# ================================
# 使用Qdrant云服务 (推荐)
QDRANT_URL=https://fdc74658-be64-4472-be97-1bce539f3d42.australia-southeast1-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NjA2ZmRhNmYtOWRmOC00Y2YzLTg4YWEtOTkwOTRiOTI3MWVmIn0._kdJfIFlrD2UdtDUd9hpYsIaalTNVbt7onqSn6xBDO4
# Qdrant集合配置
QDRANT_COLLECTION=hello_agents_vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# ================================
# Neo4j 图数据库配置 - 获取API密钥：https://neo4j.com/cloud/aura/
# ================================
# 使用Neo4j Aura云服务 (推荐)

NEO4J_URI=neo4j+s://36bef430.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ytc74RRC2jMe_D-MKEp9NnP6JKUJPOzzsKrDnU75M3Q

# Neo4j连接配置
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# 嵌入（Embedding）配置示例 - 可从阿里云控制台获取：https://dashscope.aliyun.com/
# ==========================
# - 若为空，dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=sk-f92f3376b228495ead811aa7f2e33021
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1